{
    "name": "billing-service",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:unit": "jest --coverage --passWithNoTests",
        "test:watch": "jest --watch",
        "migrate": "ts-node -r tsconfig-paths/register src/cli/migrate.ts up",
        "migrate:down": "ts-node -r tsconfig-paths/register src/cli/migrate.ts down",
        "migrate:status": "ts-node -r tsconfig-paths/register src/cli/migrate.ts status",
        "migrate:create": "ts-node -r tsconfig-paths/register src/cli/migrate.ts create",
        "migrate:reset": "ts-node -r tsconfig-paths/register src/cli/migrate.ts reset"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.20",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^10.4.20",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.4.20",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/sequelize": "^11.0.1",
        "@rentease/auth": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "pg-hstore": "^2.3.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.7",
        "sequelize-typescript": "^2.1.6",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.20",
        "@rentease/eslint-config": "workspace:*",
        "@rentease/ts-config": "workspace:*",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.10.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^9.0.8",
        "jest": "^29.7.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "~5.4.5",
        "umzug": "^3.8.2"
    }
}