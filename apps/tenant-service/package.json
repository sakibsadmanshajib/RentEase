{
    "name": "tenant-service",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:unit": "jest --coverage",
        "test:watch": "jest --watch",
        "migrate": "ts-node -r tsconfig-paths/register src/cli/migrate.ts up",
        "migrate:down": "ts-node -r tsconfig-paths/register src/cli/migrate.ts down",
        "migrate:status": "ts-node -r tsconfig-paths/register src/cli/migrate.ts status",
        "migrate:create": "ts-node -r tsconfig-paths/register src/cli/migrate.ts create",
        "migrate:reset": "ts-node -r tsconfig-paths/register src/cli/migrate.ts reset"
    },
    "dependencies": {
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^4.0.2",
        "@rentease/common": "workspace:*",
        "@nestjs/core": "^10.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/sequelize": "^11.0.1",
        "@types/passport-jwt": "^4.0.1",
        "axios": "^1.13.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.13.1",
        "pg-hstore": "^2.3.4",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "sequelize": "^6.37.5",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@rentease/eslint-config": "workspace:*",
        "@rentease/ts-config": "workspace:*",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/sequelize": "^6.12.0",
        "@types/supertest": "^6.0.0",
        "jest": "^29.5.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3",
        "umzug": "^3.8.2"
    }
}