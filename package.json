{
  "name": "RentEase",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:api",
    "test:unit": "turbo test:unit",
    "test:api": "API_ONLY=true playwright test --grep @api",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test tests/e2e --workers=1",
    "test:ci": "pnpm test:unit && pnpm test:api && pnpm test:integration && pnpm test:e2e",
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter='!web' --filter='!api-gateway'",
    "start": "turbo start",
    "build": "turbo build",
    "verify:identity": "./scripts/verify-identity.sh",
    "verify:tenant": "./scripts/verify-tenant.sh",
    "verify:property": "./scripts/verify-property.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@nestjs/core",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.4",
    "axios": "^1.13.2",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "sequelize": "^6.37.7",
    "ts-node": "^10.9.2",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "umzug": "^3.8.2"
  }
}